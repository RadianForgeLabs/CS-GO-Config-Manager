<Window x:Class="CSGOConfigManager.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS:GO Config Manager — RFL Studios"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="CanResizeWithGrip"
        Width="360" Height="680"
        MinWidth="320" MinHeight="400">
    <Border Background="#CC1E1E2E" CornerRadius="12" BorderBrush="#DE9B35" BorderThickness="2" Padding="16"
            MouseLeftButtonDown="OnDrag">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="32" Click="OnClose"
                        Background="#33FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="16" FontWeight="Bold"/>
                <StackPanel>
                    <TextBlock Text="CS:GO Config Manager" FontWeight="Bold" FontSize="16"
                               Foreground="#DE9B35" VerticalAlignment="Center"/>
                    <TextBlock Text="RFL Studios" Foreground="#88A0A0B8" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="F10 to toggle • Settings apply to all game modes instantly" 
                       Foreground="#88A0A0B8" FontSize="11" Margin="0,12,0,0" TextAlignment="Center"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Bot Configuration -->
                    <Border Background="#252535" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🤖 Bot Configuration" Foreground="#DE9B35" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quota:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DockPanel Grid.Column="1">
                                    <TextBlock Text="{Binding BotManager.Quota, StringFormat={}{0}}" Foreground="#DE9B35" Width="30" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding BotManager.Quota}" ValueChanged="OnBotSettingChanged"/>
                                </DockPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mode:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding BotManager.QuotaModes}" 
                                          SelectedItem="{Binding BotManager.QuotaMode}" SelectionChanged="OnBotSettingChanged"
                                          Background="#2A2A3A" Foreground="White" BorderThickness="1" BorderBrush="#444"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Difficulty:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DockPanel Grid.Column="1">
                                    <TextBlock Text="{Binding BotManager.Difficulty}" Foreground="#DE9B35" Width="20" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding BotManager.Difficulty}" Margin="8,0,0,0" ValueChanged="OnBotSettingChanged"/>
                                </DockPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Team:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding BotManager.JoinTeams}" 
                                          SelectedItem="{Binding BotManager.JoinTeam}" SelectionChanged="OnBotSettingChanged"
                                          Background="#2A2A3A" Foreground="White" BorderThickness="1" BorderBrush="#444"/>
                            </Grid>

                            <CheckBox Content="Freeze Bots" IsChecked="{Binding BotManager.BotStop}" Foreground="White" Margin="0,4" Checked="OnBotSettingChanged" Unchecked="OnBotSettingChanged"/>
                            <CheckBox Content="Don't Shoot" IsChecked="{Binding BotManager.DontShoot}" Foreground="White" Margin="0,4" Checked="OnBotSettingChanged" Unchecked="OnBotSettingChanged"/>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="T Only" Command="{Binding BotManager.PresetTOnlyCommand}" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="CT Only" Command="{Binding BotManager.PresetCtOnlyCommand}" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="5 Bots" Command="{Binding BotManager.Preset5Command}" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="10 Bots" Command="{Binding BotManager.Preset10Command}" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="Kick All" Click="OnKickBots" Margin="0,0,4,4" Padding="8,3"
                                        Background="#CC3333" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Practice Settings -->
                    <Border Background="#252535" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🎯 Practice Settings" Foreground="#DE9B35" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            
                            <CheckBox Content="sv_cheats" IsChecked="{Binding SvCheats}" Foreground="White" Margin="0,4" Checked="OnPracticeSettingChanged" Unchecked="OnPracticeSettingChanged"/>
                            <CheckBox Content="Infinite Ammo" IsChecked="{Binding InfiniteAmmo}" Foreground="White" Margin="0,4" Checked="OnPracticeSettingChanged" Unchecked="OnPracticeSettingChanged"/>
                            <CheckBox Content="Grenade Trajectory" IsChecked="{Binding GrenadeTrajectory}" Foreground="White" Margin="0,4" Checked="OnPracticeSettingChanged" Unchecked="OnPracticeSettingChanged"/>
                            <CheckBox Content="Buy Anywhere" IsChecked="{Binding BuyAnywhere}" Foreground="White" Margin="0,4" Checked="OnPracticeSettingChanged" Unchecked="OnPracticeSettingChanged"/>
                            <CheckBox Content="Show Impacts" IsChecked="{Binding ShowImpacts}" Foreground="White" Margin="0,4" Checked="OnPracticeSettingChanged" Unchecked="OnPracticeSettingChanged"/>
                            <CheckBox Content="God Mode" IsChecked="{Binding GodMode}" Foreground="White" Margin="0,4" Checked="OnPracticeSettingChanged" Unchecked="OnPracticeSettingChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Game Controls -->
                    <Border Background="#252535" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚡ Game Controls" Foreground="#DE9B35" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="End Round" Tag="endround" Click="OnQuickCommand" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="Restart" Tag="mp_restartgame 1" Click="OnQuickCommand" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="End Warmup" Tag="mp_warmup_end" Click="OnQuickCommand" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="Respawn" Tag="respawn" Click="OnQuickCommand" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </WrapPanel>

                            <WrapPanel>
                                <Button Content="Give AK-47" Tag="give weapon_ak47" Click="OnQuickCommand" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="Give M4A4" Tag="give weapon_m4a1" Click="OnQuickCommand" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="Give AWP" Tag="give weapon_awp" Click="OnQuickCommand" Margin="0,0,4,4" Padding="8,3"
                                        Background="#333348" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Round Settings -->
                    <Border Background="#252535" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⏱️ Round Settings" Foreground="#DE9B35" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Round Time:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="RoundTimeBox" Text="1.92" Grid.Column="1" 
                                         Background="#2A2A3A" Foreground="White" BorderThickness="1" BorderBrush="#444" Padding="4" Margin="0,0,8,0"/>
                                <Button Content="Set" Tag="mp_roundtime_defuse" Click="OnSetRoundValue" Grid.Column="2" Padding="8,3"
                                        Background="#DE9B35" Foreground="#1E1E2E" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Freeze Time:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="FreezeTimeBox" Text="15" Grid.Column="1" 
                                         Background="#2A2A3A" Foreground="White" BorderThickness="1" BorderBrush="#444" Padding="4" Margin="0,0,8,0"/>
                                <Button Content="Set" Tag="mp_freezetime" Click="OnSetRoundValue" Grid.Column="2" Padding="8,3"
                                        Background="#DE9B35" Foreground="#1E1E2E" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Max Rounds:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="MaxRoundsBox" Text="30" Grid.Column="1" 
                                         Background="#2A2A3A" Foreground="White" BorderThickness="1" BorderBrush="#444" Padding="4" Margin="0,0,8,0"/>
                                <Button Content="Set" Tag="mp_maxrounds" Click="OnSetRoundValue" Grid.Column="2" Padding="8,3"
                                        Background="#DE9B35" Foreground="#1E1E2E" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Warmup Time:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="WarmupTimeBox" Text="60" Grid.Column="1" 
                                         Background="#2A2A3A" Foreground="White" BorderThickness="1" BorderBrush="#444" Padding="4" Margin="0,0,8,0"/>
                                <Button Content="Set" Tag="mp_warmuptime" Click="OnSetRoundValue" Grid.Column="2" Padding="8,3"
                                        Background="#DE9B35" Foreground="#1E1E2E" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Custom Command -->
                    <Border Background="#252535" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💻 Custom Command" Foreground="#DE9B35" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBox x:Name="ConsoleCommandBox" Text="Enter console command..." 
                                     Background="#2A2A3A" Foreground="White" BorderThickness="1" BorderBrush="#444" Padding="8" Margin="0,0,0,8"/>
                            <Button Content="Generate &amp; Copy Command" Click="OnExecuteCommand" Padding="10,6"
                                    Background="#DE9B35" Foreground="#1E1E2E" BorderThickness="0" HorizontalAlignment="Stretch" Cursor="Hand" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Apply All Button -->
                    <Button Content="🚀 Apply All Settings to All Game Modes" Click="OnApplyAllSettings" Margin="0,8,0,0" Padding="12,8"
                            Background="#DE9B35" Foreground="#1E1E2E" BorderThickness="0" HorizontalAlignment="Stretch" Cursor="Hand" FontSize="13" FontWeight="SemiBold"/>

                    <!-- Copy Exec Command Button -->
                    <Button Content="📋 Copy Exec Command" Click="OnCopyExecCommand" Margin="0,8,0,0" Padding="12,8"
                            Background="#333348" Foreground="White" BorderThickness="0" HorizontalAlignment="Stretch" Cursor="Hand" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
