<UserControl x:Class="CSGOConfigManager.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Conflict Detector" Style="{StaticResource TitleText}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Shows where commands are set across config layers. Higher-priority files win (practice/gamemode over autoexec over config.cfg). ★ / * marks the effective value."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,16,0"/>
            <CheckBox Content="Only show conflicts" IsChecked="{Binding OnlyConflicts}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="160"/>
                <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveValue}" Width="90"/>
                <DataGridTextColumn Header="Source" Binding="{Binding EffectiveSource}" Width="180"/>
                <DataGridCheckBoxColumn Header="Conflict" Binding="{Binding HasConflict}" Width="70"/>
                <DataGridTextColumn Header="All Sources" Binding="{Binding AllSources}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
