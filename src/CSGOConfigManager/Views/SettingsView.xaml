<UserControl x:Class="CSGOConfigManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="CS:GO Config Manager" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Data-driven config manager for CS:GO Legacy (1.38.x)" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <TextBlock Text="Developed by" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                    <TextBlock Text="RFL Studios" FontWeight="SemiBold" Foreground="#DE9B35" Margin="0,0,0,2"/>
                    <TextBlock Text="A division of RadianForgeLabs" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8"/>
                    
                    <Button Content="Visit RadianForgeLabs Website" Command="{Binding VisitWebsiteCommand}" 
                            Style="{StaticResource SecondaryButton}" Margin="0,8,0,8" HorizontalAlignment="Left" Padding="12,6"/>
                    
                    <TextBlock Text="Version 1.0.0" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
                    <TextBlock Text="© 2026 RadianForgeLabs. All rights reserved." Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
                    <TextBlock Text="Based on original CS:GO Config Manager project (MIT License)" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" Foreground="#88A0A0B8"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Third-Party Licenses" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="Microsoft.Win32.Registry" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="© Microsoft Corporation. Licensed under MIT License." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock Text="https://learn.microsoft.com/dotnet/api/microsoft.win32.registry" Style="{StaticResource MutedText}" FontSize="10" Foreground="#88A0A0B8" Margin="0,0,0,8"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CS:GO Path" Style="{StaticResource SectionTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseCsgoCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding CsgoPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="7Launcher Executable" Style="{StaticResource SectionTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseSevenLauncherCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding SevenLauncherPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="RevLoader Executable" Style="{StaticResource SectionTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseRevLoaderCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding RevLoaderPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="Custom Launch Args" Style="{StaticResource SectionTitle}"/>
                    <TextBox Text="{Binding CustomArgs, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Default Launch Method" Style="{StaticResource SectionTitle}"/>
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding LaunchMethods}"
                              SelectedItem="{Binding DefaultMethod}"/>

                    <TextBlock Text="Overlay Display Method" Style="{StaticResource SectionTitle}"/>
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding OverlayDisplayMethods}"
                              SelectedItem="{Binding OverlayDisplayMethod}"/>

                    <CheckBox Content="Auto-backup before overwriting configs" IsChecked="{Binding AutoBackup}" Margin="0,16,0,0"/>

                    <TextBlock Text="Max Backups to Keep" Style="{StaticResource SectionTitle}"/>
                    <TextBox Text="{Binding MaxBackups, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>

                    <TextBlock Text="Config Filename" Style="{StaticResource SectionTitle}"/>
                    <TextBox Text="{Binding ConfigFileName, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Detect Paths" Command="{Binding DetectCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
