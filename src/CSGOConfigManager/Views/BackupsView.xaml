<UserControl x:Class="CSGOConfigManager.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Backups" Style="{StaticResource TitleText}"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,0"/>
            <Button Content="Create Backup" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Export ZIP" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Diff autoexec" Command="{Binding DiffCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Backups}" SelectedItem="{Binding Selected}"
                     DisplayMemberPath="DisplayName"/>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Diff / Details" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding DiffText}" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
